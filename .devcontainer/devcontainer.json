{
  "name": "SynFinder",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -e '.[web,dev]'",
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "SynFinder", "onAutoForward": "openPreview" }
  },
  "postAttachCommand": "./run_web.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
